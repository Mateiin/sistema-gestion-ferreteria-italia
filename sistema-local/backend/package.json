{
  "name": "sistema-local",
  "version": "0.1.0",
  "description": "Caja, cuentas corrientes y facturacion ARCA para el local",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build:frontend": "cd ../frontend && npx ng build --configuration production",
    "copiar:frontend": "tsx scripts/copiar-frontend.ts",
    "build:prod": "npm run build:frontend && npm run copiar:frontend && npm run build",
    "probar:fe": "tsx scripts/probar-facturacion.ts",
    "verificar:prod": "tsx scripts/verificar-produccion.ts",
    "probar:calculo": "tsx scripts/probar-calculo-iva.ts",
    "probar:pdf": "tsx scripts/probar-pdf.ts",
    "backup": "tsx scripts/backup.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@arcasdk/core": "2.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pdfmake": "0.3.11",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.11.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
