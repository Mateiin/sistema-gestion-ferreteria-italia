# Generado por el instalador de Ferreteria (ver ferreteria.iss) el {{FECHA_INSTALACION}}.
# NO se versiona, NO sale de esta PC. Si hace falta tocar algo a mano despues,
# es este mismo archivo -- vive en la carpeta de instalacion.

# --- Puerto del servidor ---
PORT=3000

# --- Base de datos (PostgreSQL nativo) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
DB_NAME={{DB_NAME}}

# --- Emisor (datos fiscales del comercio que factura) ---
EMISOR_ID=ferreteria
EMISOR_RAZON_SOCIAL="{{EMISOR_RAZON_SOCIAL}}"
EMISOR_CUIT={{EMISOR_CUIT}}
EMISOR_PUNTO_VENTA={{EMISOR_PUNTO_VENTA}}
EMISOR_CONDICION_IVA=RI
EMISOR_DOMICILIO_COMERCIAL="{{EMISOR_DOMICILIO_COMERCIAL}}"
EMISOR_INGRESOS_BRUTOS={{EMISOR_INGRESOS_BRUTOS}}
EMISOR_INICIO_ACTIVIDADES={{EMISOR_INICIO_ACTIVIDADES}}
# Logo opcional: pegalo en la carpeta certs\ (junto al certificado) y
# descomenta la linea de abajo con el nombre real del archivo.
# EMISOR_LOGO_PATH=certs\logo-ferreteria.png

# --- ARCA / WSAA / WSFEv1 ---
# CRITICO: homologacion a proposito. El salto a produccion (CUIT de la
# empresa, punto de venta real, certificado de produccion) es un paso APARTE
# y posterior, a mano -- ver docs/INSTALACION.md y CLAUDE.md -> Despliegue.
ARCA_AMBIENTE=homologacion
# Los certificados NO los pone el instalador (ver TAREA 4 / seguridad): se
# copian a mano en la carpeta certs\ despues de instalar.
ARCA_CERT_PATH=certs\homologacion.crt
ARCA_KEY_PATH=certs\homologacion.key

# --- Backup (scripts/backup.ts -- ver scripts/README-backup.md) ---
BACKUP_DIR_LOCAL={{BACKUP_DIR_LOCAL}}
# Opcionales -- si no estan definidas, o el path no existe/no esta montado,
# el backup lo salta con un WARNING y sigue con el resto.
# BACKUP_DIR_PENDRIVE=D:\Backups
# BACKUP_DIR_DRIVE=C:\Users\CAMBIAR\Google Drive\Backups Ferreteria
# node.exe embebido trae su propio pg_dump? No -- pg_dump lo pone Postgres.
# Esta ruta la completa el instalador con la version detectada/instalada.
PG_DUMP_PATH={{PG_DUMP_PATH}}
