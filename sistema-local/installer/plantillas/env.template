# Generado por el instalador de Ferreteria (ver ferreteria.iss) el {{FECHA_INSTALACION}}.
# NO se versiona, NO sale de esta PC. Si hace falta tocar algo a mano despues,
# es este mismo archivo -- vive en la carpeta de instalacion.

# --- Puerto del servidor ---
PORT=3000

# --- Base de datos (PostgreSQL nativo) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
DB_NAME={{DB_NAME}}

# --- Superusuario de Postgres (SOLO para restore -- ver scripts/README-backup.md) ---
# ferreteria_app NO tiene permiso para CREATE DATABASE ni CREATE EXTENSION:
# el paso 1 del restore documentado (crear la base antes de aplicar el dump)
# necesita el superusuario. Si el instalador instalo Postgres desde cero, esta
# contrasena es ALEATORIA y este .env es el UNICO lugar donde queda -- si se
# pierde este archivo sin haberla guardado aparte (gestor de contrasenas), un
# restore real requiere resetear la contrasena del superusuario a mano.
PG_SUPERUSER_USER={{PG_SUPERUSER_USER}}
PG_SUPERUSER_PASSWORD={{PG_SUPERUSER_PASSWORD}}

# --- Emisor (datos fiscales del comercio que factura) ---
EMISOR_ID=ferreteria
EMISOR_RAZON_SOCIAL="{{EMISOR_RAZON_SOCIAL}}"
EMISOR_CUIT={{EMISOR_CUIT}}
EMISOR_PUNTO_VENTA={{EMISOR_PUNTO_VENTA}}
EMISOR_CONDICION_IVA=RI
EMISOR_DOMICILIO_COMERCIAL="{{EMISOR_DOMICILIO_COMERCIAL}}"
EMISOR_INGRESOS_BRUTOS={{EMISOR_INGRESOS_BRUTOS}}
EMISOR_INICIO_ACTIVIDADES={{EMISOR_INICIO_ACTIVIDADES}}
# Logo: lo copia el propio instalador a certs\logo-ferreteria.png (no es un
# secreto, viaja embebido en el .exe -- ver ferreteria.iss). Si por algun
# motivo ese archivo no esta (instalador viejo sin el logo todavia), esto
# simplemente no encuentra el archivo y el PDF cae al texto de la razon
# social, sin romper nada.
EMISOR_LOGO_PATH=certs/logo-ferreteria.png

# --- ARCA / WSAA / WSFEv1 ---
# CRITICO: homologacion a proposito. El salto a produccion (CUIT de la
# empresa, punto de venta real, certificado de produccion) es un paso APARTE
# y posterior, a mano -- ver docs/INSTALACION.md y CLAUDE.md -> Despliegue.
ARCA_AMBIENTE=homologacion
# Los certificados NO los pone el instalador (ver TAREA 4 / seguridad): se
# copian a mano en la carpeta certs\ despues de instalar.
ARCA_CERT_PATH=certs\homologacion.crt
ARCA_KEY_PATH=certs\homologacion.key

# --- Backup (scripts/backup.ts -- ver scripts/README-backup.md) ---
BACKUP_DIR_LOCAL="{{BACKUP_DIR_LOCAL}}"
# Pendrive resuelto por ETIQUETA de volumen, no por letra de unidad -- asi
# funciona en cualquier puerto USB, sin importar que letra le toque cada vez.
# Etiqueta el pendrive con este mismo nombre (ver docs/INSTALACION.md ->
# "Etiquetar el pendrive de backup"). Vacio = no se usa pendrive; se puede
# completar despues a mano, no hace falta reinstalar.
BACKUP_PENDRIVE_LABEL="{{BACKUP_PENDRIVE_LABEL}}"
# Alternativa vieja (ruta fija en vez de etiqueta) -- se sigue soportando
# como respaldo/override manual si la preferis, pero BACKUP_PENDRIVE_LABEL
# es mas robusto (no depende de que le toque siempre la misma letra). Si las
# dos estan seteadas, se intenta primero la etiqueta.
# BACKUP_DIR_PENDRIVE=D:\Backups
# Carpeta de Google Drive sincronizada por el cliente de escritorio de
# Google Drive (NO es la API de Drive -- hace falta tenerlo instalado y con
# sesion iniciada, ver docs/INSTALACION.md). Vacio = no se usa Drive; se
# puede completar despues a mano.
BACKUP_DIR_DRIVE="{{BACKUP_DIR_DRIVE}}"
# node.exe embebido trae su propio pg_dump? No -- pg_dump lo pone Postgres.
# Esta ruta la completa el instalador con la version detectada/instalada.
PG_DUMP_PATH={{PG_DUMP_PATH}}
