{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd sistema-local/frontend && npm install",
  "buildCommand": "cd sistema-local/frontend && ng build --configuration production",
  "outputDirectory": "sistema-local/frontend/dist/frontend/browser",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
