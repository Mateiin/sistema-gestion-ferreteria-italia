# Copiá este archivo a ".env" en esta misma carpeta y completá los valores reales.
# El ".env" real NUNCA se sube a git (ver .gitignore).

# --- Emisor (datos fiscales del comercio que factura) ---
EMISOR_ID=ferreteria
EMISOR_RAZON_SOCIAL="Ferreteria Italia"
EMISOR_CUIT=20123456783
# Punto de venta habilitado en ARCA EXCLUSIVO para este sistema
# (no debe ser el mismo que usás para facturar a mano en la web de ARCA)
EMISOR_PUNTO_VENTA=4
EMISOR_CONDICION_IVA=RI
# Obligatorios en el comprobante IMPRESO (no los pide WSFEv1, pero sin esto el
# PDF queda incompleto/legalmente inválido para imprimir).
EMISOR_DOMICILIO_COMERCIAL=
EMISOR_INGRESOS_BRUTOS=
EMISOR_INICIO_ACTIVIDADES=
# Opcional: logo del emisor para el encabezado del PDF (factura y presupuesto).
# .png o .jpg. Si falta o no se puede leer, el PDF cae al texto de la razón
# social sin romper la generación.
# EMISOR_LOGO_PATH=../../certs/logo-ferreteria.png

# --- ARCA / WSAA / WSFEv1 ---
# Empezá SIEMPRE en homologacion. Recien pasar a produccion cuando este probado.
ARCA_AMBIENTE=homologacion

# Rutas a los archivos del certificado y la clave privada que emite ARCA.
# La clave (.key) es SECRETA: nunca se versiona en git ni se comparte
# (el .gitignore ya excluye *.crt, *.key y la carpeta certs/).
# certs/ vive en la raíz del repo, dos niveles arriba de este backend/.
ARCA_CERT_PATH=../../certs/ferreteria.crt
ARCA_KEY_PATH=../../certs/ferreteria.key

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ferreteria_local

# --- Backup (scripts/backup.ts -- ver scripts/README-backup.md) ---
BACKUP_DIR_LOCAL=./backups
# Etiqueta del volumen del pendrive de backup (no la letra de unidad -- se
# resuelve en cada corrida, funciona en cualquier puerto USB). Opcional.
# BACKUP_PENDRIVE_LABEL=BACKUP_FERRE
# Forma vieja (ruta fija) -- fallback/override manual, opcional.
# BACKUP_DIR_PENDRIVE=D:\Backups
# Carpeta local que sincroniza el cliente de escritorio de Google Drive
# (no es la API de Drive). Opcional.
# BACKUP_DIR_DRIVE=C:\Users\CAMBIAR\Google Drive\Backups Ferreteria
# Ruta al ejecutable de pg_dump si no está en el PATH del sistema. Opcional.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
